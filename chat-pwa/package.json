{
  "name": "trinaxai-chat",
  "private": true,
  "version": "1.2.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 3334",
    "build": "tsc && vite build && npm run build:server",
    "build:server": "esbuild vite-security.ts inference-lock.ts security-headers.ts --outdir=server-dist --format=esm --platform=node --target=node22",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "preview": "npm run serve",
    "preview:vite": "vite preview --port 3334",
    "serve": "node server.mjs",
    "test": "vitest run && npm run test:server",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:server": "npm run build:server && node --test server.integration.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "katex": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "react-markdown": "^9.0.3",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.12.1",
    "browserslist": "^4.28.7",
    "esbuild": "^0.25.12",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "ejs": "^6.0.1"
  }
}
